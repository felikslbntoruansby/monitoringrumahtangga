{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/login(\\.html)?",
      "dest": "/login.html"
    },
    {
      "src": "/rumahtangga(\\.html)?",
      "dest": "/index.html"
    },
    {
      "src": "/ruangan(\\.html)?",
      "dest": "/ruangan.html"
    },
    {
      "src": "/kendaraan(\\.html)?",
      "dest": "/kendaraan.html"
    },
    {
      "src": "/inventaris(\\.html)?",
      "dest": "/inventaris.html"
    },
    {
      "src": "/ac(\\.html)?",
      "dest": "/ac.html"
    },
    {
      "src": "/unit-ac(\\.html)?",
      "dest": "/unit-ac.html"
    },
    {
      "src": "/apar(\\.html)?",
      "dest": "/apar.html"
    },
    {
      "src": "/unit-apar(\\.html)?",
      "dest": "/unit-apar.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}